# CONFIGURAÇÕES DO DOCUSIGN ESIGNATURE API (ENVIRONMENT VARIABLES)
# Obtenha estas credenciais no portal de desenvolvedor (demo.docusign.net) ou produção

# 1. Credenciais Principais
DOCUSIGN_CLIENT_ID=seu_integration_key_aqui
DOCUSIGN_USER_ID=seu_user_id_aqui
DOCUSIGN_ACCOUNT_ID=seu_account_id_aqui

# 2. Chave Privada RSA (Cole com as quebras ou \n correspondente)
DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMINHA_CHAVE_PRIVADA_COMPLETA_AQUI\n-----END RSA PRIVATE KEY-----"

# 3. Servidores (account-d.docusign.com e demo.docusign.net para ambiente Sandbox/Demo)
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi

# 4. Pasta de Destino das Cartas Firmadas (OneDrive de sua empresa)
DOCUSIGN_LOCAL_SAVE_PATH="C:\Users\BR23636\OneDrive - Cirion Technologies\Asset Management\Cartas Firmadas"

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // DEFAULT DENY: Bloqueio global de segurança
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields:
    //   - id: string (required) - Firebase Auth UID
    //   - username: string (required) - Display name
    //   - email: string (required) - User email
    //   - isAdmin: bool (required) - Admin privilege
    //   - createdAt: number (optional) - Creation timestamp
    //
    // Collection: exchanges
    // Fields:
    //   - id: string (required)
    //   - operationType: string (required) - exchange, delivery, return
    //   - status: string (required) - draft, pending_receiver, completed
    //   - timestamp: number (required)
    //   - colaborador_nome: string (required)
    //   - createdBy: string (required) - UID of creator
    //
    // Collection: emails
    // Fields:
    //   - id: string (required)
    //   - to: string (required)
    //   - subject: string (required)
    //   - sentAt: string | number (required)
    //
    // Collection: audit_logs
    // Fields:
    //   - action: string (required)
    //   - exchangeId: string (optional)
    //   - envelopeId: string (optional)
    //   - timestamp: timestamp | number (required)
    //   - user: string (optional)
    //   - error: string (optional)
    //   - reason: string (optional)
    //   - filePath: string (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions de Segurança e Blindagem
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Validador exclusivo para o proprietário master: gibasuporte@gmail.com
    function isOnlyGibaSuporte() {
      return isAuthenticated() && 
             request.auth.token.email != null &&
             request.auth.token.email.lower().trim() == "gibasuporte@gmail.com";
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'username', 'email', 'isAdmin']) &&
             data.id is string &&
             data.username is string &&
             data.email is string && 
             data.isAdmin is bool;
    }

    function isValidExchange(data) {
      return data.keys().hasAll(['id', 'operationType', 'status', 'timestamp', 'colaborador_nome', 'createdBy']) &&
             data.id is string &&
             data.operationType in ['exchange', 'delivery', 'return'] &&
             data.status in ['draft', 'pending_receiver', 'completed'] &&
             (data.timestamp is number || data.timestamp is timestamp) &&
             data.colaborador_nome is string && data.colaborador_nome.size() > 0 &&
             data.createdBy is string &&
             (!('docusign_status' in data) || data.docusign_status in ['pending', 'completed', 'declined', 'voided']);
    }

    function isValidEmail(data) {
      return data.keys().hasAll(['id', 'to', 'subject', 'sentAt']) &&
             data.id is string &&
             data.to is string &&
             data.subject is string;
    }

    // ===============================================================
    // Regras Blindadas por Coleção
    // Somente gibasuporte@gmail.com possui permissão de escrita e edição
    // ===============================================================

    // Usuários do Sistema
    match /users/{userId} {
      // Usuários autenticados podem ler dados ou gibasuporte@gmail.com pode auditar todos
      allow read: if isAuthenticated();
      
      // Somente gibasuporte@gmail.com pode criar, alterar ou excluir contas de usuários
      allow create, update: if isOnlyGibaSuporte() && isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isOnlyGibaSuporte() && resource.data.email.lower() != "gibasuporte@gmail.com";
    }

    // Ativos e Termos de Responsabilidade (Exchanges)
    match /exchanges/{exchangeId} {
      // Leitura permitida para usuários autenticados para fins de auditoria e inventário
      allow read: if isAuthenticated();
      
      // REGRA DE OURO: Somente gibasuporte@gmail.com pode gravar, editar ou remover ativos
      allow create: if isOnlyGibaSuporte() && isValidId(exchangeId) && isValidExchange(request.resource.data);
      allow update: if isOnlyGibaSuporte() && isValidId(exchangeId) && isValidExchange(request.resource.data);
      allow delete: if isOnlyGibaSuporte() && isValidId(exchangeId);
    }

    // Notificações e Histórico de E-mails do Outlook
    match /emails/{emailId} {
      // Leitura autorizada apenas para o administrador ou para o destinatário do e-mail
      allow read: if isAuthenticated() && (isOnlyGibaSuporte() || resource.data.to == request.auth.token.email);
      
      // Gravação e atualização restrita ao gestor oficial gibasuporte@gmail.com
      allow create, update: if isOnlyGibaSuporte() && isValidId(emailId) && isValidEmail(request.resource.data);
      allow delete: if isOnlyGibaSuporte() && isValidId(emailId);
    }

    // Trilha de Auditoria (Audit Logs) - Imutável e Protegida
    match /audit_logs/{logId} {
      // Somente gibasuporte@gmail.com pode consultar registros de auditoria
      allow read: if isOnlyGibaSuporte();
      
      // Somente gibasuporte@gmail.com ou serviços autorizados podem registrar eventos de log
      allow create: if isOnlyGibaSuporte() && isValidId(logId);
      
      // Logs de auditoria são estritamente imutáveis para garantir conformidade legal
      allow update, delete: if false;
    }
  }
}
